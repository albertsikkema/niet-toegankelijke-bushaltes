# Copy to .env and fill in the values. Never commit .env.

# CARTO basemaps API key — get one at https://carto.com/basemaps/apikey/
# Used by pipeline/write-config.js to generate docs/js/config.js.
# In CI this comes from the CARTO_API_KEY repository secret.
CARTO_API_KEY=

# GitHub token — used by Claude Code for container-based development (repo scope only)
GH_TOKEN=
